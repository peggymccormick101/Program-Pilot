# Anthropic (Claude) -- required for the automated workflow steps
ANTHROPIC_API_KEY=
# Optional, only if your key is tied to a specific workspace
ANTHROPIC_WORKSPACE_ID=

# Jira Cloud -- required for steps that read Feature data (Provide
# Development Capacity, Generate Draft Roadmap Options). Create an API
# token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
